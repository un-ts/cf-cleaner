{
  "name": "cf-cleaner",
  "version": "0.2.0",
  "type": "module",
  "description": "Cleanup Confluence HTML via rehype",
  "repository": "git+https://github.com/un-ts/cf-cleaner.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=14.18.0"
  },
  "bin": {
    "cfc": "./lib/cli.js"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./lib/rehype-confluence": "./lib/rehype-confluence.js",
    "./lib/rehype-confluence.js": "./lib/rehype-confluence.js"
  },
  "types": "lib",
  "files": [
    "lib",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:r": "r -f cjs",
    "build:ts": "tsc -p src",
    "lint": "run-p lint:*",
    "lint:es": "eslint . --cache -f friendly --max-warnings 10",
    "lint:tsc": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "test": "vitest run --coverage",
    "typecov": "type-coverage"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "hast-util-is-element": "^3.0.0",
    "rehype-format": "^5.0.0",
    "rehype-parse": "^9.0.0",
    "rehype-preset-minify": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "unified": "^11.0.0",
    "unified-stream": "^3.0.0",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@1stg/lib-config": "^13.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "type-coverage": "^2.27.0",
    "typescript": "^7.0.0",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^0.34.6"
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreNonNullAssertion": true,
    "showRelativePath": true,
    "strict": true,
    "update": true
  }
}
